    - target: {fileID: 8462908634919313066, guid: 6f9a3398f45c39b47a75eba882b98181, type: 3}
      propertyPath: m_text
      value: "Ve al estante de la izquierda y toma un cuadrado y un tri\xE1ngulo
        de acero inoxidable, coloca el cuadrado en la parte superior central de la
        zona de trabajo y el tri\xE1ngulo a mano derecha de esa zona, formando la
        figura de un trapecio rect\xE1ngulo como se muestra en la imagen"
      objectReference: {fileID: 0}
